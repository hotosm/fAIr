{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "useTabs": false,
  "endOfLine": "lf",
  "ignorePatterns": [
    "build/**",
    "coverage/**",
    "node_modules/**",
    "dist/**",
    "public/**",
    "**/*.min.js",
    "**/*.bundle.js"
  ]
}
