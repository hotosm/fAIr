[Unit]
Description=fAIr Application Stack
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/fAIr-app
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.dev.yml down
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
